import "walk_mod.qbe" as walk_mod

module qsvt_mod {
    class QSVT {
        properties {
            num num_coefs
            num num_ancillas
            num num_qubits
            num num_phases
        }
        methods {
            func QSVT(QSVT self, num num_coefs, num num_ancillas, num num_qubits, num num_phases){
                num_coefs -> self.num_coefs
                num_ancillas -> self.num_ancillas
                num_qubits -> self.num_qubits
                num_phases -> self.num_phases
            }
            func apply(QSVT self, qusys(2)[] ancillas, qusys(2)[] qubits, num[] coefs, num[] pauli_strings, num[] sign, num[] phases){
                Walk(self.num_coefs, self.num_ancillas, self.num_qubits) -> Walk walk
                for {1 -> num i}{i <= self.num_phases}{i + 1 -> i}{
                    -phases.[i] - 3.141592653589793 / 2 -> num right_alpha
                    self.partial_reflection(ancillas, right_alpha)
                    walk.apply(ancillas, qubits, coefs, pauli_strings, sign)
                    phases.[i] + 3.141592653589793 / 2 -> num left_alpha
                    self.partial_reflection(ancillas, left_alpha)
                }
            }
            func partial_reflection(QSVT self, qusys(2)[] ancillas, num alpha){
                3.141592653589793 + alpha -> num phase
                for {1 -> num i}{i <= self.num_ancillas}{i + 1 -> i}{ x[ancillas.[i]] }
                if {self.num_ancillas == 1} {
                    globalphase(phase / 2)[ancillas.[1]]
                    rz(-phase / 2)[ancillas.[1]]
                } elif {self.num_ancillas == 2} {
                    if {ancillas.[1]} {
                        globalphase(phase / 2)[ancillas.[2]]
                        rz(-phase / 2)[ancillas.[2]]
                    }
                } else {
                    qusys(2)[] work
                    self.num_ancillas - 2 -> num n_work
                    for {1 -> num i}{i <= n_work}{i + 1 -> i}{ qubit -> work.[i] }
                    toffoli[ancillas.[1], ancillas.[2], work.[1]]
                    for {1 -> num i}{i <= (n_work - 1)}{i + 1 -> i}{
                        toffoli[ancillas.[i + 2], work.[i], work.[i + 1]]
                    }
                    if {work.[n_work]} {
                        if {ancillas.[self.num_ancillas]} {
                            globalphase(phase / 2)[ancillas.[self.num_ancillas]]
                            rz(-phase / 2)[ancillas.[self.num_ancillas]]
                        }
                    }
                    for {1 -> num k}{k <= (n_work - 1)}{k + 1 -> k}{
                        n_work - k -> num i
                        toffoli[ancillas.[i + 2], work.[i], work.[i + 1]]
                    }
                    toffoli[ancillas.[1], ancillas.[2], work.[1]]
                }
                for {1 -> num k}{k <= self.num_ancillas}{k + 1 -> k}{
                    self.num_ancillas - k + 1 -> num i
                    x[ancillas.[i]]
                }
            }
        }
    }
}
